<%- include('partials/header') -%>
  <div class="container">
    <div class="row mt-5">
      <div class="col-6">
        <div>
          <p><strong>User Name</strong>: <%= user.userName %>
          </p>
          <!-- <p><strong>Email</strong>: <%= user.email %>
          </p> -->
          <a href="/logout" class="col-3 btn btn-primary">Logout</a>
        </div>
        <div class="mt-5">
          <h2>Add a post</h2>
          <form action="/post/createPost" enctype="multipart/form-data" method="POST">
            
            <div class="mb-3">
              <label for="company" class="form-label">Company's Name</label>
              <input id="company" name="company" type="text" class="form-control">
            </div>

            <div class="mb-3">
              <label for="brand" class="form-label">Brand</label>
              <input id="brand" name="brand" type="text" class="form-control">
            </div>

            <div class="mb-3">
              <label for="location" class="form-label">Location(s)</label>
              <input id="location" name="location" type="text" class="form-control" >
            </div>
            
            <div class="mb-3">Business Type</div>
            <div class="mb-3">
              <label for="software" class="form-label">
                <input id="software" value="software" name="businessType" type="radio" class="" /> Software /
                AI</label>
            </div>
            <div class="mb-3">
              <label for="hardware" class="form-label">
                <input id="hardware" value="hardware" name="businessType" type="radio" class="" /> Hardware /
                Wearable</label>
            </div>
            <div class="mb-3">
              <label for="finance" class="form-label">
                <input id="finance" value="finance" name="businessType" type="radio" class="" /> Finance / Investor </label>
            </div>
            <div class="mb-3">
              <label for="pr" class="form-label">
                <input id="pr" value="pr" name="businessType" type="radio" class="" /> Publication / Marketing </label>
            </div>
            <div class="mb-3">
              <label for="media" class="form-label">
                <input id="media" value="media" name="businessType" type="radio" class="" /> Media </label>
            </div>
            <div class="mb-3">
              <label for="other" class="form-label">
                <input id="other" value="other" name="businessType" type="radio" class="" /> Other </label>
            </div>
            

            <div class="mb-3">
              <label for="ps" class="form-label">Tell us about the Product or Service you offer</label>
              <textarea id="ps" name="ps" class="form-control"></textarea>
            </div>

            <div class="mb-3">
              <label for="about" class="form-label">About Us</label>
              <textarea id="about" name="about" class="form-control"></textarea>
            </div>

            <div class="mb-3">
              <label for="looking" class="form-label">What are you looking for to take your company to the next level?</label>
              <textarea id="looking" name="looking" class="form-control"></textarea>
            </div>

            <div class="mb-3">
              <label for="contact" class="form-label">Contact Details</label>
              <input id="contact" name="contact" type="text" class="form-control" >
            </div>

            <div class="mb-3">
              <label for="imgUpload" class="form-label">Logo</label>
              <input type="file" class="form-control" id="imageUpload" name="file">
            </div>
            <button type="submit" class="btn btn-primary" value="Upload">Submit</button>
          </form>
        </div>
      </div>
      <div class="col-6">
        <ul class="row list-unstyled">
          <% for(var i=0; i<posts.length; i++) {%>
            <li class="col-6 justify-content-between mt-5">
              <a href="/post/<%= posts[i]._id%>">
                <img class="img-fluid" src="<%= posts[i].image%>">
              </a>
            </li>
            <% } %>
        </ul>
        <div class="row justify-content-center mt-5">
          <a class="btn btn-primary" href="/feed">All Companies</a>
        </div>
      </div>
    </div>
  </div>
  </div>
  <%- include('partials/footer') -%>