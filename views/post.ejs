<%- include('partials/header') -%>
  <div class="container">
    <div class="row justify-content-center mt-5">
      <div class="col-6">
        <img class="img-fluid" src="<%= post.image%>" />
        <div class="row justify-content-between">
          <form class="col-1" action="/post/likePost/<%= post.id %>?_method=PUT" method="POST">
            <button class="btn btn-primary fa fa-heart" type="submit"></button>
          </form>
          <h3 class="col-3">Likes: <%= post.likes %>
          </h3>
          <%if(post.user==user.id){ %>
            <form action="/post/deletePost/<%= post.id %>?_method=DELETE" method="POST" class="col-3">
              <button class="btn btn-primary fa fa-trash" type="submit"></button>
            </form>
            <%}%>

        </div>
      </div>

      <div class="col-3 mt-5">
        <%if(post.user==user.id){ %>
          <div class="mt-5">
            <h2>Update a post</h2>
            <form action="/post/updatePost/<%= post.id %>?_method=POST" enctype="multipart/form-data" method="POST">
              <div class="mb-3">
                <label for="brand" class="form-label">Brand</label>
                <input id="brand" name="brand" value="<%= post.brand %>" type="text" class="form-control">
              </div>
              <div class="mb-3">
                <label for="company" class="form-label">Company's Name</label>
                <input id="company" name="company" value="<%= post.company %>" type="text" class="form-control" >
              </div>

              <div class="mb-3">Business Type</div>
              <div class="mb-3">
                <label for="software" class="form-label">
                  <input id="software" name="businessType" value="<%= post.businessType %>" type="radio" class="" /> Software /
                  AI</label>
              </div>
              <div class="mb-3">
                <label for="hardware" class="form-label">
                  <input id="hardware" name="businessType" value="<%= post.businessType %>" type="radio" class="" /> Hardware /
                  Wearable</label>
              </div>

              <div class="mb-3">
                <label for="about" class="form-label">About Us</label>
                <textarea id="about" name="about" class="form-control"><%= post.about %></textarea>
              </div>
              <div class="mb-3">
                <label for="imgUpload" class="form-label">Image</label>
                <input type="file" class="form-control" id="imageUpload" name="file">
              </div>
              <button type="submit" class="btn btn-primary" value="Upload">Submit</button>
            </form>
          </div>
          <%} else {%>

            <h6>Brand</h6>
            <%= post.brand %>

              <h6>Company Name</h6>
              <%= post.company %>

                <h6>About Us</h6>
                <%= post.about %>
                  <%}%>
      </div>

      <div class="col-6 mt-5">
        <a class="btn btn-primary" href="/profile">Return to Profile</a>
        <a class="btn btn-primary" href="/feed">Return to Feed</a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') -%>