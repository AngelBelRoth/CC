<%- include('partials/header') -%>

  <div class="container">
    <div class="row justify-content-center mt-5">
      <div class="col-6">

        <img class="img-fluid" src="<%= post.image%>" />

        <div class="row justify-content-between">

          <form class="col-1" action="/post/<%= post.id %>/toggle-favorite" method="POST">
            <button class="btn btn-primary fa fa-heart <%= user.favorites.includes(post.id) ? 'text-primary' : '' %>"
              type="submit"></button>
          </form>


          <form class="col-1" action="/post/likePost/<%= post.id %>?_method=PUT" method="POST">
            <button class="btn btn-primary fa fa-thumbs-up <%= post.likedBy.includes(user.id) ? 'text-info' : '' %>"
              type="submit"></button>
          </form>
          <h3 class="col-3">Likes: <%= post.likes %>
          </h3>

          <%if(post.user==user.id){ %>
            <form action="/post/deletePost/<%= post.id %>?_method=DELETE" method="POST" class="col-3">
              <button class="btn btn-primary fa fa-trash" type="submit"></button>
            </form>
            <%}%>
        </div>
      </div>

      <div class="col-3">
        <%if(post.user==user.id){ %>
          <div>
            <h5>Update Company's Info</h5>
            <form action="/post/updatePost/<%= post.id %>?_method=POST" enctype="multipart/form-data" method="POST">

              <div class="mb-3">
                <label for="brand" class="form-label">Brand</label>
                <input id="brand" name="brand" value="<%= post.brand %>" type="text" class="form-control">
              </div>

              <div class="mb-3">
                <label for="company" class="form-label">Company's Name</label>
                <input id="company" name="company" value="<%= post.company %>" type="text" class="form-control">
              </div>

              <div class="mb-3">
                <label for="location" class="form-label">Location(s)</label>
                <input id="location" name="location" value="<%= post.location %>" type="text" class="form-control">
              </div>

              <div class="mb-3">Business Type</div>
              <div class="mb-3">
                <label for="fb" class="form-label">
                  <% if (post.businessType==="fb" ) { %>
                    <input id="fb" name="businessType" value="fb" type="radio" class="" checked />
                    <%} else {%>
                      <input id="fb" name="businessType" value="fb" type="radio" class="" />
                      <%}%>
                        Food / Beverage
                </label>
              </div>

              <div class="mb-3">
                <label for="therapy" class="form-label">
                  <% if (post.businessType==="fb" ) { %>
                    <input id="therapy" name="businessType" value="therapy" type="radio" class="" checked />
                    <%} else {%>
                      <input id="therapy" name="businessType" value="therapy" type="radio" class="" />
                      <%}%>
                        Healing / Therapy
                </label>
              </div>

              <div class="mb-3">
                <label for="software" class="form-label">
                  <% if (post.businessType==="software" ) { %>
                    <input id="software" name="businessType" value="software" type="radio" class="" checked />
                    <%} else {%>
                      <input id="software" name="businessType" value="software" type="radio" class="" />
                      <%}%>
                        Software / AI
                </label>
              </div>

              <div class="mb-3">
                <label for="hardware" class="form-label">
                  <% if (post.businessType==="hardware" ) { %>
                    <input id="hardware" name="businessType" value="hardware" type="radio" class="" checked />
                    <%} else {%>
                      <input id="hardware" name="businessType" value="hardware" type="radio" class="" />
                      <%}%>
                        Hardware / Wearable
                </label>
              </div>

              <div class="mb-3">
                <label for="finance" class="form-label">
                  <% if (post.businessType==="finance" ) { %>
                    <input id="finance" name="businessType" value="finance" type="radio" class="" checked />
                    <%} else {%>
                      <input id="finance" name="businessType" value="finance" type="radio" class="" />
                      <%}%>
                        Finance / Investor
                </label>
              </div>

              <div class="mb-3">
                <label for="pr" class="form-label">
                  <% if (post.businessType==="pr" ) { %>
                    <input id="pr" name="businessType" value="pr" type="radio" class="" checked />
                    <%} else {%>
                      <input id="pr" name="businessType" value="pr" type="radio" class="" />
                      <%}%>
                        Publication / Marketing
                </label>
              </div>

              <div class="mb-3">
                <label for="media" class="form-label">
                  <% if (post.businessType==="media" ) { %>
                    <input id="media" name="businessType" value="media" type="radio" class="" checked />
                    <%} else {%>
                      <input id="media" name="businessType" value="media" type="radio" class="" />
                      <%}%>
                        Media
                </label>
              </div>

              <div class="mb-3">
                <label for="other" class="form-label">
                  <% if (post.businessType==="other" ) { %>
                    <input id="other" name="businessType" value="other" type="radio" class="" checked />
                    <%} else {%>
                      <input id="other" name="businessType" value="other" type="radio" class="" />
                      <%}%>
                        Other
                </label>
              </div>

              <div class="mb-3">
                <label for="ps" class="form-label">The Product or Service that we offer</label>
                <textarea id="ps" name="ps" class="form-control"><%= post.ps %></textarea>
              </div>

              <div class="mb-3">
                <label for="about" class="form-label">About Us</label>
                <textarea id="about" name="about" class="form-control"><%= post.about %></textarea>
              </div>

              <div class="mb-3">
                <label for="looking" class="form-label">What we are looking for to take our company to the next
                  level?</label>
                <textarea id="looking" name="looking" class="form-control"><%= post.looking %></textarea>
              </div>

              <div class="mb-3">
                <label for="contact" class="form-label">Contact Details</label>
                <input id="contact" name="contact" value="<%= post.contact %>" type="text" class="form-control">
              </div>

              <div class="mb-3">
                <label for="imgUpload" class="form-label">Logo</label>
                <input type="file" class="form-control" id="imageUpload" name="file">
              </div>
              <button type="submit" class="btn btn-primary" value="Upload">Submit</button>
            </form>
          </div>
          <%} else {%>

            <h6>Brand</h6>
            <%= post.brand %>
              <div class="break"></div>
              <h6>Company Name</h6>
              <%= post.company %>
                <div class="break"></div>
                <h6>Location(s)</h6>
                <%= post.location %>
                  <div class="break"></div>
                  <!-- <h6>Business Type</h6>
                  <%= post.businessType %>
                    <div class="break"></div> -->
                  <h6>The Product or Service that we offer</h6>
                  <%= post.ps %>
                    <div class="break"></div>
                    <h6>About Us</h6>
                    <%= post.about %>
                      <div class="break"></div>
                      <h6>What we are looking for to take our company to the next level?</h6>
                      <%= post.looking %>
                        <div class="break"></div>
                        <h6>Contact Details</h6>
                        <%= post.contact %>
                          <%}%>
      </div>

      <div class="col-12 mt-5">
        <h4>Reviews & Ratings</h4>

        <% if (post.totalReviews> 0) { %>
          <div class="mb-3">
            <strong>Average Rating: <%= post.averageRating %> / 5</strong>
            (<%= post.totalReviews %>
              <%= post.totalReviews===1 ? 'review' : 'reviews' %>)
          </div>
          <% } else { %>
            <p>No reviews yet. Be the first to review!</p>
            <% } %>

              <!-- Add Review Form -->
              <div class="card mb-4">
                <div class="card-body">
                  <h5>Write a Review</h5>
                  <form action="/post/<%= post.id %>/review" method="POST">
                    <div class="mb-3">
                      <label class="form-label">Rating</label>
                      <div>
                        <label><input type="radio" name="rating" value="5" required> ⭐⭐⭐⭐⭐ (5)</label><br>
                        <label><input type="radio" name="rating" value="4"> ⭐⭐⭐⭐ (4)</label><br>
                        <label><input type="radio" name="rating" value="3"> ⭐⭐⭐ (3)</label><br>
                        <label><input type="radio" name="rating" value="2"> ⭐⭐ (2)</label><br>
                        <label><input type="radio" name="rating" value="1"> ⭐ (1)</label>
                      </div>
                    </div>

                    <div class="mb-3">
                      <label for="comment" class="form-label">Your Review</label>
                      <textarea id="comment" name="comment" class="form-control" rows="3" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Submit Review</button>
                  </form>
                </div>
              </div>

              <!-- Display Reviews -->
              <div class="reviews-list">
                <% if (post.reviews && post.reviews.length> 0) { %>
                  <h5>All Reviews</h5>
                  <% post.reviews.reverse().forEach(review=> { %>
                    <div class="card mb-3">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                          <div>
                            <strong>
                              <%= review.userName %>
                            </strong>
                            <div>
                              <% for(let i=0; i < review.rating; i++) { %>⭐<% } %>
                                  (<%= review.rating %>/5)
                            </div>
                          </div>
                          <% if (review.user.toString()===user.id.toString()) { %>
                            <form action="/post/<%= post.id %>/review/<%= review._id %>?_method=DELETE" method="POST">
                              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                            </form>
                            <% } %>
                        </div>
                        <p class="mt-2">
                          <%= review.comment %>
                        </p>
                        <small class="text-muted">
                          <%= new Date(review.createdAt).toLocaleDateString() %>
                        </small>
                      </div>
                    </div>
                    <% }) %>
                      <% } %>
              </div>
      </div>

      <div class="row justify-content-center mt-5">
        <a class="btn btn-primary" href="/feed">All Companies</a>
      </div>

    </div>
  </div>

  <%- include('partials/footer') -%>